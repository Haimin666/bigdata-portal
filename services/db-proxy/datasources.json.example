{
  "authToken": "CHANGE_ME",
  "listenHost": "0.0.0.0",
  "listenPort": 8756,
  "defaultLimit": 1000,
  "maxLimit": 500000,
  "maxSqlLen": 32768,
  "queryTimeout": 60,
  "maxConcurrent": 5,
  "maxQps": 10,
  "connectTimeout": 5,
  "oracleClientLib": "/usr/lib/oracle/19.19/client64/lib",
  "dataSync": {
    "enabled": false,
    "hiveMetastore": {
      "host": "CHANGE_ME",
      "port": 3306,
      "user": "CHANGE_ME",
      "password": "CHANGE_ME",
      "database": "hive"
    },
    "datax": {
      "mysqlUsername": "",
      "mysqlPassword": "CHANGE_ME",
      "oracleUsername": "CHANGE_ME",
      "oraclePassword": "CHANGE_ME"
    },
    "datasourceOverrides": {},
    "defaultFs": "hdfs://lbc",
    "hadoopConfig": {}
  },
  "impala": {
    "typeCheck": {"enabled": true},
    "aiFix": {
      "enabled": false,
      "baseUrl": "https://your-compatible-api.example/v1",
      "apiKey": "CHANGE_ME",
      "model": "CHANGE_ME",
      "timeout": 60,
      "maxAttempts": 2
    }
  },
  "spark": {
    "enabled": false,
    "master": "yarn",
    "appName": "db-proxy-spark",
    "queue": "default",
    "executorMemory": "2g",
    "executorCores": 2,
    "executorInstances": 0,
    "sparkConf": {},
    "jdbcUrl": "jdbc:hive2://127.0.0.1:10001/default",
    "user": "root",
    "beelinePath": "",
    "defaultLimit": 1000,
    "maxLimit": 500000,
    "maxSqlLen": 65536,
    "exportPath": "hdfs:///tmp/db-proxy-spark-exports"
  },
  "flink": {
    "enabled": true,
    "javaHome": "/root/whm/jdk/jdk-11.0.32+9",
    "flinkHome": "",
    "hiveLib": "",
    "yarnAppId": "application_xxx",
    "sessionName": "db-proxy-flink-session",
    "queue": "default",
    "defaultLimit": 1000,
    "maxLimit": 500000,
    "queryTimeout": 300,
    "allowWrite": true,
    "catalogs": [
      "CREATE CATALOG paimon_hive_store WITH ('type'='paimon', 'metastore'='hive', 'uri'='thrift://hadoop-nn-1.bigdata.shiqiao.com:9083,thrift://hadoop-nn-2.bigdata.shiqiao.com:9083', 'warehouse'='hdfs://lbc/user/hive/paimon/')"
    ],
    "defaultCatalog": "paimon_hive_store",
    "pipelineJars": [
      "file:///opt/streamx/flink/flink-1.17.2/lib/paimon-flink-1.17-0.8-20240507.002037-81.jar",
      "file:///opt/streamx/flink/flink-1.17.2/lib/flink-sql-connector-mysql-cdc-2.4.2.jar",
      "file:///opt/streamx/flink/flink-1.17.2/lib/flink-sql-connector-kafka-1.17.2.jar"
    ],
    "prejob": {
      "enabled": true,
      "flinkHome": "/opt/streamx/flink/flink-1.17.2",
      "pythonBin": "/root/whm/py38/bin/python3.8",
      "javaHome": "/root/whm/jdk/jdk-11.0.32+9",
      "hadoopConfDir": "/etc/hadoop/conf",
      "queue": "default",
      "yarnRmUrl": "http://hadoop-nn-1.bigdata.shiqiao.com:8088",
      "jobsDir": "flink-prejobs",
      "maxConcurrent": 5,
      "submitTimeout": 120
    },
    "connectors": {
      "mysql_cdc": {
        "label": "MySQL(CDC)",
        "type": "mysql-cdc",
        "defaults": {
          "hostname": "CHANGE_ME",
          "port": "3343",
          "username": "CHANGE_ME",
          "password": "CHANGE_ME",
          "scan.incremental.snapshot.enabled": "true",
          "scan.incremental.snapshot.chunk.key-column": "id",
          "scan.startup.mode": "initial"
        },
        "dynamicFields": [
          {"key": "database-name", "label": "库名", "placeholder": "如 finance_order_trade"},
          {"key": "table-name", "label": "表名", "placeholder": "支持正则,如 t_.*"}
        ],
        "probe": {"type": "mysql"},
        "primaryKey": true
      },
      "kafka": {
        "label": "Kafka",
        "type": "kafka",
        "defaults": {
          "properties.bootstrap.servers": "CHANGE_ME_BROKER_1:9092,CHANGE_ME_BROKER_2:9092",
          "properties.group.id": "CHANGE_ME_GROUP",
          "scan.startup.mode": "earliest-offset",
          "format": "json"
        },
        "dynamicFields": [
          {"key": "topic", "label": "Topic", "placeholder": "如 bigdata-tupu-neo4j"}
        ]
      },
      "hbase": {
        "label": "HBase(维表)",
        "type": "hbase-2.2",
        "defaults": {
          "zookeeper.quorum": "CHANGE_ME_ZK_1:2181,CHANGE_ME_ZK_2:2181,CHANGE_ME_ZK_3:2181"
        },
        "dynamicFields": [
          {"key": "table-name", "label": "HBase 表名", "placeholder": "如 lion_dw:dim_cmmlion_sys_dictionary_bak"}
        ]
      }
    }
  },
  "datasources": [
    {
      "name": "mysql_example",
      "label": "MySQL",
      "type": "mysql",
      "connectionString": "mysql://CHANGE_ME:CHANGE_ME@mysql.example:3306/example_db?charset=utf8mb4"
    },
    {
      "name": "oracle_example",
      "label": "Oracle",
      "type": "oracle",
      "connectionString": "oracle://CHANGE_ME:CHANGE_ME@oracle.example:1521/service_name",
      "rowLimit": "rownum"
    },
    {
      "name": "doris_example",
      "label": "Doris",
      "type": "mysql",
      "sourceType": "doris",
      "connectionString": "mysql://CHANGE_ME:CHANGE_ME@doris.example:9030/default?charset=utf8mb4"
    },
    {
      "name": "impala_example",
      "label": "Impala",
      "type": "impala",
      "hosts": ["impala-1.example", "impala-2.example"],
      "port": 21050,
      "user": "CHANGE_ME",
      "password": "CHANGE_ME",
      "database": "default",
      "readOnly": true
    }
  ]
}
