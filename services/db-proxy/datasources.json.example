{
  "authToken": "CHANGE_ME",
  "listenHost": "0.0.0.0",
  "listenPort": 8756,
  "defaultLimit": 100,
  "maxLimit": 10000,
  "maxSqlLen": 32768,
  "queryTimeout": 60,
  "connectTimeout": 5,
  "allowedDbs": [
    "sq_ccrs2",
    "sq_ccrs",
    "th_ccrs",
    "sqqy_ccrs",
    "pre_ccrs",
    "finance_order_trade"
  ],
  "allowedTables": [],
  "writableTables": ["finance_order_trade.*"],
  "executableProcedures": ["credzy.update_balance"],
  "oracleClientLib": "/usr/lib/oracle/19.19/client64/lib",
  "spark": {
    "enabled": false,
    "master": "yarn",
    "deployMode": "client",
    "appName": "db-proxy-spark",
    "sparkHome": "/opt/spark/spark-3.4.2-bin-hadoop3",
    "driverMemory": "4g",
    "executorMemory": "8g",
    "executorCores": 2,
    "maxExecutors": 15,
    "minExecutors": 1,
    "executorIdleTimeout": "120s",
    "queue": "default",
    "hiveMetastoreUris": "thrift://hadoop-nn-1.bigdata.shiqiao.com:9083",
    "defaultLimit": 1000,
    "maxLimit": 10000,
    "maxSqlLen": 65536,
    "allowWrite": false,
    "logDir": "spark-logs",
    "sparkConf": {}
  },
  "flink": {
    "enabled": false,
    "javaHome": "/root/whm/jdk/jdk-11.0.32+9",
    "yarnAppId": "application_xxx",
    "sessionName": "db-proxy-flink-session",
    "queue": "default",
    "defaultLimit": 1000,
    "maxLimit": 10000,
    "queryTimeout": 300,
    "allowWrite": false,
    "pipelineJars": [
      "file:///opt/streamx/flink/flink-1.17.2/lib/paimon-flink-1.17-0.8.2.jar",
      "file:///opt/streamx/flink/flink-1.17.2/lib/flink-sql-connector-mysql-cdc-2.4.2.jar",
      "file:///opt/streamx/flink/flink-1.17.2/lib/flink-sql-connector-kafka-1.17.2.jar"
    ],
    "connectors": {
      "mysql_cdc": {
        "label": "MySQL(CDC)",
        "type": "mysql-cdc",
        "defaults": {
          "hostname": "10.26.2.23",
          "port": "3343",
          "username": "bigdata_cdc",
          "password": "xxx",
          "scan.startup.mode": "initial"
        },
        "dynamicFields": [
          {"key": "database-name", "label": "库名", "placeholder": "如 finance_order_trade"},
          {"key": "table-name", "label": "表名", "placeholder": "支持正则,如 t_.*"}
        ],
        "probe": {"type": "mysql"},
        "primaryKey": true
      },
      "kafka": {
        "label": "Kafka",
        "type": "kafka",
        "defaults": {
          "properties.bootstrap.servers": "kafka-01:9092,kafka-02:9092",
          "properties.group.id": "flusr_xxx",
          "scan.startup.mode": "earliest-offset",
          "format": "json"
        },
        "dynamicFields": [
          {"key": "topic", "label": "Topic", "placeholder": "如 bigdata-tupu-neo4j"}
        ]
      },
      "hbase": {
        "label": "HBase(维表)",
        "type": "hbase-2.2",
        "defaults": {
          "zookeeper.quorum": "olap-worker-01:2181,olap-worker-02:2181,olap-worker-03:2181"
        },
        "dynamicFields": [
          {"key": "table-name", "label": "HBase 表名", "placeholder": "如 lion_dw:dim_cmmlion_sys_dictionary_bak"}
        ]
      }
    }
  },
  "datasources": [
    {
      "name": "sq_ccrs2",
      "label": "etc",
      "type": "oracle",
      "host": "10.25.2.87",
      "port": 1521,
      "user": "sq_ccrs2",
      "password": "CHANGE_ME",
      "service": "credzx",
      "rowLimit": "rownum"
    },
    {
      "name": "sq_ccrs",
      "label": "狮桥个人",
      "type": "oracle",
      "host": "10.25.2.87",
      "port": 1521,
      "user": "sq_ccrs",
      "password": "CHANGE_ME",
      "service": "credzx",
      "rowLimit": "rownum"
    },
    {
      "name": "th_ccrs",
      "label": "通汇",
      "type": "oracle",
      "host": "10.25.2.82",
      "port": 1521,
      "user": "th_ccrs",
      "password": "CHANGE_ME",
      "service": "credzy",
      "rowLimit": "rownum"
    },
    {
      "name": "sqqy_ccrs",
      "label": "狮桥企业",
      "type": "oracle",
      "host": "10.25.2.82",
      "port": 1521,
      "user": "sqqy_ccrs",
      "password": "CHANGE_ME",
      "service": "credzy",
      "rowLimit": "rownum"
    },
    {
      "name": "pre_ccrs",
      "label": "卓远",
      "type": "oracle",
      "host": "10.25.2.82",
      "port": 1521,
      "user": "pre_ccrs",
      "password": "CHANGE_ME",
      "service": "credzy",
      "rowLimit": "rownum"
    },
    {
      "name": "finance_order_trade",
      "type": "mysql",
      "host": "10.26.2.23",
      "port": 3343,
      "user": "financemxh_o0",
      "password": "CHANGE_ME",
      "schema": "finance_order_trade"
    }
  ]
}
