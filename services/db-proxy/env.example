# db-proxy 示例配置(客户机侧,复制为 .env 或 export)
# 注意:数据库密码只在这里/客户机,平台永远接触不到

# ── 多数据源 ─────────────────────────────────────────────────
# 数据源配置文件路径(JSON,含各库 type/host/port/账密/schema)。
# 参考 datasources.json.example;真实密码填在客户机的 datasources.json,
# 不进仓库。请求的 db 参数 = 数据源 name(如 credzy/credzx/nev)
DATASOURCES=datasources.json

# ── 安全白名单 ──────────────────────────────────────────────
# 允许访问的库(逗号分隔,对应数据源 name);留空 = 允许所有已配置数据源
ALLOWED_DBS=credzy,credzx,nev
# 允许访问的表(逗号分隔,支持 库.表 或 裸表名);留空 = 不校验表
ALLOWED_TABLES=
# 请求鉴权 token;留空 = 不鉴权(仅内网)
AUTH_TOKEN=change_me

# ── 行为约束 ────────────────────────────────────────────────
# 无 LIMIT 时自动追加的行数
DEFAULT_LIMIT=100
# 行数硬上限(MySQL: LIMIT / Oracle: FETCH FIRST)
MAX_LIMIT=10000
# 单查询最大执行秒数
QUERY_TIMEOUT=60
# 连接超时秒数
DB_CONNECT_TIMEOUT=5

# ── 监听 ────────────────────────────────────────────────────
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8756
