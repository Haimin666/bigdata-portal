# db-proxy 示例配置(客户机侧 env,复制为 .env 或 export)
# 注意:数据库密码只在这里/客户机,平台永远接触不到

# ── 数据库类型 ───────────────────────────────────────────────
# mysql 或 oracle(二选一)
DB_TYPE=mysql

# ── 数据库连接(客户机可直连的那个库)─────────────────────────
DB_HOST=127.0.0.1
# MySQL 默认 3306;Oracle 默认 1521
DB_PORT=3306
DB_USER=your_user
DB_PASS=your_password
# MySQL 字符集(默认 utf8mb4);Oracle 默认 AL32UTF8
DB_CHARSET=utf8mb4
# Oracle 服务名(连接串 service_name,如 ORCLPDB1);MySQL 忽略。
# 不填时用请求里的 db 参数当 service_name
ORACLE_SERVICE=

# ── 安全白名单 ──────────────────────────────────────────────
# 允许访问的库(逗号分隔);留空 = 允许所有(不推荐)
ALLOWED_DBS=lion_dw,test_db
# 允许访问的表(逗号分隔,支持 库.表 或 裸表名);留空 = 不校验表
ALLOWED_TABLES=
# 请求鉴权 token;留空 = 不鉴权(仅内网)
AUTH_TOKEN=change_me

# ── 行为约束 ────────────────────────────────────────────────
# 无 LIMIT 时自动追加的行数
DEFAULT_LIMIT=100
# 行数硬上限(MySQL: LIMIT / Oracle: FETCH FIRST)
MAX_LIMIT=10000
# 单查询最大执行秒数
QUERY_TIMEOUT=60
# 连接超时秒数
DB_CONNECT_TIMEOUT=5

# ── 监听 ────────────────────────────────────────────────────
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8756
